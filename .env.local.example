# Official UK vehicle data keys — do not expose these in browser code.
DVLA_API_KEY=your_dvla_api_key

# DVSA's current MOT API needs all values from its credentials email.
DVSA_MOT_API_KEY=your_dvsa_mot_api_key
DVSA_MOT_CLIENT_ID=your_dvsa_client_id
DVSA_MOT_CLIENT_SECRET=your_dvsa_client_secret
DVSA_MOT_SCOPE_URL=https://login.microsoftonline.com/your-tenant-id/.default
DVSA_MOT_TOKEN_URL=https://login.microsoftonline.com/your-tenant-id/oauth2/v2.0/token

# Optional: adds a short plain-English buyer briefing.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini

# Optional: after MotorCheck approves you as an affiliate, add its unique ID.
# The full-history CTA is hidden until this is set.
MOTORCHECK_AFFILIATE_ID=your_motorcheck_affiliate_id

# Public production URL, used for canonical URLs, sitemap and social previews.
# Set this before deploying, for example: https://www.yourdomain.co.uk
SITE_URL=https://www.yourdomain.co.uk
